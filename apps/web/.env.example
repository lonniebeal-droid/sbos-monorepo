# Secret used to sign session JWTs. Generate with: openssl rand -base64 48
AUTH_SECRET=

# Base URL of the SBOS REST API. The web app proxies auth and reads data from
# this origin (server-side). SBOS_API_URL takes precedence when both are set.
SBOS_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Shows the seeded demo account credentials on the login screen. Keep false
# except in a controlled demo environment — never enable on a real customer
# deployment.
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=false
