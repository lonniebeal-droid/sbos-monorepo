# Copy to apps/api/.env and fill in values. Never commit real secrets.

NODE_ENV=development
PORT=3000

# JWT — leave blank locally; generate for production:
#   openssl rand -base64 48
# Production startup rejects empty or known-placeholder values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Database
DATABASE_URL=postgresql://sbos:sbos@localhost:5432/sbos?schema=public

# Optional providers (console fallbacks used when unset)
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Jessie AI chat — OpenAI-compatible (OpenAI, Azure, local gateways)
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Jessie / ElevenLabs secure server-tool adapter
ELEVENLABS_AGENT_TOOLS_SECRET=
ELEVENLABS_AGENT_TOOLS_ORGANIZATION_ID=
ELEVENLABS_AGENT_TOOLS_ACTOR_ID=

# Payments — Stripe
STRIPE_SECRET_KEY=

# Email — Resend
RESEND_API_KEY=
EMAIL_FROM=no-reply@sbos.health

# SMS — Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Jessie / ElevenLabs agent tool secrets (required in production).
# Multiple secrets per org allowed; duplicate secrets rejected at startup.
# Format: orgId:secret[,orgId2:secret2] — syntactically valid fake example only:
# JESSIE_AGENT_SECRETS=org_example_replace_me:secret_example_replace_me
# Generate real secrets with: openssl rand -base64 32  (never commit real values)
