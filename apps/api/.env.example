# HTTP port the API listens on
PORT=4000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# JWT signing secrets — REQUIRED in production.
# Generate with: openssl rand -base64 48
# Access and refresh must differ. Leave blank here; never commit real values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Access token lifetime (Nest/jsonwebtoken duration string, e.g. 15m, 1h)
JWT_ACCESS_TTL=15m

# Refresh token lifetime (e.g. 7d)
JWT_REFRESH_TTL=7d

# Database connection string
DATABASE_URL=postgresql://sbos:sbos@localhost:5432/sbos?schema=public

# Optional AI note assistant (heuristic is used when unset)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Email (Resend). When unset, console provider logs outbound mail.
# RESEND_API_KEY=
# EMAIL_FROM=noreply@example.com

# SMS (Twilio). When unset, console provider logs outbound SMS.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Jessie / ElevenLabs agent tool secrets (required in production).
# Multiple secrets per org allowed; duplicate secrets rejected at startup.
# Format: orgId:secret,orgId2:secret2  (secret maps to organization server-side)
# Generate secrets with: openssl rand -base64 32
# JESSIE_AGENT_SECRETS=
