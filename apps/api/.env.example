# HTTP port the API listens on
PORT=4000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# JWT signing secrets (use long random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# Access token lifetime in seconds (default 15 minutes)
JWT_ACCESS_TTL_SECONDS=900

# Refresh token lifetime in seconds (default 7 days)
JWT_REFRESH_TTL_SECONDS=604800

# Database connection string
DATABASE_URL=postgresql://sbos:sbos@localhost:5432/sbos?schema=public

# Optional AI note assistant (heuristic is used when unset)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Email (Resend). When unset, console provider logs outbound mail.
# RESEND_API_KEY=
# EMAIL_FROM=noreply@example.com

# SMS (Twilio). When unset, console provider logs outbound SMS.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Jessie / ElevenLabs agent tool secrets.
# Format: orgId:secret,orgId2:secret2  (secret maps to organization server-side)
# JESSIE_AGENT_SECRETS=
