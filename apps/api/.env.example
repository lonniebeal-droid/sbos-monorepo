# HTTP port the API listens on
PORT=4000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# JWT signing secrets (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sbos?schema=public

# --- Live provider integrations (optional) ---
# Each provider activates automatically when its key is set; otherwise SBOS uses
# the built-in offline default (heuristic chat / manual payments / console
# email+SMS).

# Jessie AI chat — OpenAI-compatible (OpenAI, Azure, local gateways)
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Payments — Stripe
STRIPE_SECRET_KEY=

# Email — Resend
RESEND_API_KEY=
EMAIL_FROM=no-reply@sbos.health

# SMS — Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
