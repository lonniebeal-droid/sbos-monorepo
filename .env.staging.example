# SBOS Staging Environment Variables
# Copy to .env and fill in values before deploying to Railway staging.
# NEVER commit real secrets. Use Railway's secret management UI.

# ============================================================
# REQUIRED - Database (PostgreSQL)
# ============================================================
# Provided automatically by Railway PostgreSQL plugin:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?schema=public

# ============================================================
# REQUIRED - API Service
# ============================================================
# JWT secrets - generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=           # MUST differ from JWT_ACCESS_SECRET

# CORS - exact staging web origin (no trailing slash)
CORS_ORIGINS=https://staging-web.your-domain.com

# API port (Railway assigns PORT automatically, but default for local)
PORT=4000

# ============================================================
# REQUIRED - Web Service
# ============================================================
# Session signing secret - generate with: openssl rand -base64 48
AUTH_SECRET=

# API URL - Railway internal service URL (e.g., http://api.railway.internal:4000)
SBOS_API_URL=

# Public API URL for browser requests
NEXT_PUBLIC_API_URL=

# ============================================================
# OPTIONAL - Redis (for distributed rate limiting)
# ============================================================
# Enable Redis-backed throttler store for multi-instance deployments
# REDIS_URL=redis://user:pass@host:6379
# REDIS_ENABLE_THROTTLER_STORE=true

# ============================================================
# OPTIONAL - External Services (only if actively testing)
# ============================================================
# OpenAI / AI Provider
# OPENAI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Stripe (payments)
# STRIPE_SECRET_KEY=

# Resend (email)
# RESEND_API_KEY=
# EMAIL_FROM=no-reply@staging.your-domain.com

# Twilio (SMS)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ============================================================
# GENERATED BY RAILWAY (do not set manually)
# ============================================================
# RAILWAY_PROJECT_ID=
# RAILWAY_SERVICE_ID=
# RAILWAY_ENVIRONMENT_ID=
# RAILWAY_DEPLOYMENT_ID=
# PORT= (assigned per service)

# ============================================================
# EXTERNAL DEPENDENCIES (configure in Railway UI)
# ============================================================
# PostgreSQL: Railway PostgreSQL plugin provides DATABASE_URL
# Redis: Railway Redis plugin provides REDIS_URL (if Redis-backed rate limiting is enabled)