# SBOS — production environment template.
# Copy to `.env` for docker compose, or set these in your platform's secret
# manager (Railway, AWS, Fly, etc.). Never commit real secrets.

# ------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------
POSTGRES_USER=sbos
POSTGRES_PASSWORD=            # REQUIRED — strong random value
POSTGRES_DB=sbos
# For non-compose deploys, set the full URL the API connects with:
# DATABASE_URL=postgresql://user:pass@host:5432/sbos?schema=public

# ------------------------------------------------------------------
# Secrets (REQUIRED in production — the API refuses to start otherwise)
# Generate each with: openssl rand -base64 48
# ------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=           # must differ from the access secret
AUTH_SECRET=                  # web session cookie signing secret

# ------------------------------------------------------------------
# Networking
# ------------------------------------------------------------------
CORS_ORIGINS=https://app.yourdomain.com
# JWT token lifetimes (optional)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ------------------------------------------------------------------
# Live provider integrations (optional — offline defaults when unset)
# ------------------------------------------------------------------
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
STRIPE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM=no-reply@yourdomain.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ------------------------------------------------------------------
# Jessie / ElevenLabs agent tools (REQUIRED for live agent webhooks)
# Format: orgId:secret[,orgId2:secret2...]
# Multiple secrets per org allowed; duplicate secrets rejected at startup.
# Generate: openssl rand -base64 32
# Never commit real org IDs or secrets.
# ------------------------------------------------------------------
JESSIE_AGENT_SECRETS=
