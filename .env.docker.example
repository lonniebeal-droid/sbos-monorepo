# Copy to .env and adjust before running `docker compose up`.
# docker-compose.yml reads these values (with sane defaults for local use).

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sbos

# API JWT secrets (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Web session signing secret (generate with: openssl rand -base64 48)
AUTH_SECRET=

# Allowed CORS origins for the API
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional one-time bootstrap token for creating the first org/admin on a fresh host
ADMIN_BOOTSTRAP_TOKEN=

# Jessie agent tool secrets (required in production for ElevenLabs webhooks)
# JESSIE_AGENT_SECRETS=org_example_replace_me:secret_example_replace_me
